{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompetitorResearchInput",
  "description": "Define a bounded public competitor research task.",
  "type": "object",
  "properties": {
    "brand_category": {
      "type": "string",
      "minLength": 1
    },
    "target_audience": {
      "type": "string",
      "minLength": 1
    },
    "markets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "competitors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "research_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "max_sources": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    }
  },
  "required": [
    "brand_category",
    "target_audience",
    "markets"
  ],
  "additionalProperties": false
}
