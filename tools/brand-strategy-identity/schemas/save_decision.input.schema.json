{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SaveBrandDecisionInput",
  "description": "Record an attributable decision against an exact version.",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "approver_id": {
      "type": "string",
      "minLength": 1
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifact_uri": {
      "type": "string",
      "minLength": 1
    },
    "artifact_version": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "project_id",
    "decision_id",
    "decision",
    "approver_id",
    "approved_at",
    "artifact_uri",
    "artifact_version"
  ],
  "additionalProperties": false
}
